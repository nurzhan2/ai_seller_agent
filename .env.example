# Скопируйте в .env и заполните. .env в git не попадает (см. .gitignore).

# --- Авито ---
# Личный кабинет продавца → Настройки → Авито API → Зарегистрировать приложение
AVITO_CLIENT_ID=your_client_id_here
AVITO_CLIENT_SECRET=your_client_secret_here
AVITO_USER_ID=your_avito_user_id_here
# Секрет в пути вебхука — заменяет проверку подписи, алгоритм которой Авито
# не публикует. Минимум 32 символа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AVITO_WEBHOOK_SECRET=
AVITO_MAX_CONCURRENCY=5
AVITO_TIMEOUT_SECONDS=20
AVITO_MAX_RETRIES=3
# Объявления, по которым агент НЕ отвечает, через запятую. Основной способ
# фильтрации: новое объявление комплекса начинает работать сразу, без правки
# переменной. Пять посторонних (вакансия, продажа глэмпинга, арендный
# бизнес, продажа банного комплекса, квартира-студия) зашиты значением по
# умолчанию — эту строку можно не задавать и не копировать вовсе.
# ПУСТОЕ значение = действуют дефолты (а не «не блокировать ничего»):
# скопированная пустая строка не должна беззвучно выключать фильтр.
# Выключить фильтр осознанно: AVITO_BLOCKED_ITEMS=none
# AVITO_BLOCKED_ITEMS=8204183112,8076244626,8076019723,7980739861,8172444564
# Аварийный режим «пускать только вот эти»: если задан, он В ПРИОРИТЕТЕ над
# чёрным списком. Обычно пусто. Список id: python -m scripts.export_listings
AVITO_ALLOWED_ITEMS=
# Обращения из профиля продавца (chat_type u2u/a2u) приходят без item_id —
# объявления у такого чата нет по спеку Авито. true (по умолчанию) — агент
# отвечает и первым сообщением уточняет направление.
AVITO_ALLOW_CHATS_WITHOUT_ITEM=true

# Агент сам ставит бронь в YCLIENTS. ВЫКЛЮЧЕНО, и включать нельзя:
# create_booking ставит реальную запись без единой проверки оплаты, только
# занятости (аудит 2026-08-28).
#
# Сейчас флаг вообще ни на что не влияет: этап оплаты передаётся оператору
# (payment.yaml: handoff_on_payment_step: true), и агент не бронирует ни при
# каком его значении — он доводит диалог до оплаты и отдаёт человеку готовую
# карточку. Значение здесь обязано совпадать с дефолтом в app/config.py:
# .env.example копируют в .env по docs/GO_LIVE.md, и `true` в примере
# включал автобронирование у всех, кто выполнил инструкцию буквально.
AUTO_BOOKING_ENABLED=false

# --- Anthropic ---
# ТОЛЬКО для харнесса качества: судья по тону (claude-opus-5) и
# scripts/replay.py --provider anthropic. Диалоги с клиентами ведёт DeepSeek,
# Anthropic как провайдер диалога убран (2026-08-30) — в проде этот ключ всё
# время был заглушкой, то есть «резерв» не сработал бы ни разу. В Railway
# переменная не нужна вовсе.
ANTHROPIC_API_KEY=

# --- LLM-провайдер (промт №12) ---
# Провайдер один: deepseek. Ключ заказчика, их токены, их расходы.
# См. docs/PROVIDER_COMPARISON.md.
LLM_PROVIDER=deepseek
# Резервный провайдер: включается сам после LLM_FALLBACK_AFTER_ERRORS подряд
# ошибок основного. Настроить сейчас НЕЧЕМ — провайдер ровно один, а переход
# deepseek -> deepseek не спасает ни от чего (тот же адрес, тот же ключ).
# Оставлено пустым; механизм ждёт второго настоящего провайдера.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_AFTER_ERRORS=3
DEEPSEEK_API_KEY=
# DeepSeek v4 по умолчанию думает перед ответом (thinking-блок) — выключено
# здесь во избежание пустых ответов при маленьком max_tokens и ради честного
# сравнения стоимости с Anthropic. См. app/agent/providers/deepseek_provider.py.
DEEPSEEK_ENABLE_THINKING=false

# --- Telegram (операторский контур) ---
TELEGRAM_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_OPS_CHAT_ID=-1001234567890
# Через запятую: 111111111,222222222
TELEGRAM_ALLOWED_USERS=

# --- Админка ---
# Пусто отключает админку (503), а не открывает всем — см. app/admin/routes.py.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Поллинг Авито ---
# Вебхуки по объявлениям комплекса не доставляются: за всю историю базы 49
# входящих, и ВСЕ u2i-чаты среди них — по объявлениям из чёрного списка
# (квартира-студия, продажа комплекса). По разрешённым объявлениям бань и
# гриль-домиков — ни одного события. Поэтому поллер основной канал, вебхук
# второй. Подробности — app/avito/poller.py.
# ВЫКЛЮЧЕН после инцидента 2026-08-28 (65 сообщений в старые чаты) —
# включать обратно только вручную, вместе с AGENT_MIN_INBOUND_TS ниже.
POLLER_ENABLED=false
POLLER_INTERVAL_SECONDS=60
POLLER_CHATS_PAGE_SIZE=100
# ПОТОЛОК API, А НЕ НАШ ВЫБОР: offset=1100 отдаёт 400 Bad Request.
POLLER_MAX_OFFSET=1000
POLLER_MESSAGES_PAGE_SIZE=20
POLLER_MAX_MESSAGE_PAGES=10
# Гуард «своё ли объявление»: поллер видит весь ящик, включая чаты, где
# владелец аккаунта сам покупатель (репетитор, покос травы, чайник — 33 чата
# на 1100). Список объявлений аккаунта обновляется раз в час.
POLLER_ITEMS_REFRESH_SECONDS=3600
POLLER_ITEMS_STATUSES=active,old,removed

# Публичный адрес сервиса. Пусто — суточная перепривязка вебхука не
# запускается (о чём будет предупреждение в логе при старте).
PUBLIC_BASE_URL=
WEBHOOK_RESUBSCRIBE_INTERVAL_HOURS=24

# --- Порог возраста входящих ---
# Единственная защита от «ответили в чат месячной давности». 0 — выключена.
# Выставляется вручную (unix-секунды) при включении POLLER_ENABLED обратно —
# см. app/config.py:agent_min_inbound_ts.
AGENT_MIN_INBOUND_TS=0

# --- Инфраструктура ---
DATABASE_URL=postgresql+asyncpg://parmangal:parmangal@postgres:5432/parmangal
REDIS_URL=redis://redis:6379/0

ENV=local

# ВАЖНО: DRY_RUN=true означает, что агент НЕ пишет клиентам в Авито —
# ответы сохраняются в БД и дублируются оператору в Telegram.
# Выключать только осознанно, после прогона метрик модерации.
DRY_RUN=true

# Сколько ответов агент даёт в одном чате, дальше чат уходит оператору
# насовсем. Сбросить счётчик КОНКРЕТНОГО чата, не трогая лимит:
# /reset <chat_id> в операторском боте.
AGENT_MAX_REPLIES_PER_CHAT=25

# Суточный лимит ВСЕХ исходящих сообщений (все чаты вместе), не рублей и не
# ответов в одном чате. Считается в Redis, сбрасывается в полночь по Москве;
# при достижении — алерт в Telegram, а не тихая остановка. См.
# app/channels/daily_limit.py.
#
# 0 = лимита нет. Это ДОПУСТИМОЕ, но осознанное значение: при нём app/main.py
# пишет WARNING на каждом старте. Не оставляйте переменную незаданной в
# надежде «выключить» лимит — дефолт кода 300, а не 0.
OUTBOUND_DAILY_LIMIT=300

# Что делает агент, когда в чате появился живой менеджер (он пишет клиенту
# сам из интерфейса Авито). Инцидент 2026-08-27/28: агент отвечал поверх.
#   off       — не влияет ни на что, агент отвечает всегда. Отладочный режим:
#               в бою это и есть тот самый инцидент.
#   cooldown  — ДЕФОЛТ. Агент молчит TAKEOVER_COOLDOWN_MINUTES минут с
#               последнего сообщения менеджера, потом продолжает сам.
#   permanent — молчит, пока чат не вернут кнопкой «Вернуть ИИ».
# НЕ путать с ручным hold (/hold <chat_id>): тот не снимается ни кулдауном,
# ни сменой режима — только командой /unhold.
TAKEOVER_MODE=cooldown
TAKEOVER_COOLDOWN_MINUTES=15

# Дневной потолок расхода на модели, рубли. Считается на каждом ходу агента
# по тому же полю, что показывает /admin/costs; сутки московские, счётчик
# переживает рестарт (заполняется из БД при старте). При достижении агент
# уходит на ПАУЗУ и сам с неё не возвращается: полночь обнуляет счётчик, но
# не паузу — нужен /resume от оператора. См. app/metrics.py:DailyCostGuard.
#
# 0 = потолка нет, WARNING на каждом старте. Как и у лимита исходящих:
# незаданная переменная не означает «лимита нет», дефолт кода 3000.
DAILY_COST_LIMIT_RUB=3000

# --- Отложенные касания (регламент скидок) ---
# Молчание клиента после названной цены — через сколько минут второе
# касание (мягкое напоминание). Третье — по тому же интервалу от второго.
TOUCH_REMINDER_DELAY_MINUTES=30
# Как часто фоновый воркер проверяет диалоги с истёкшим таймером.
TOUCH_SCHEDULER_INTERVAL_SECONDS=60
# Максимум касаний на диалог — дальше молчим.
TOUCH_MAX_COUNT=3
